# Copier ce fichier vers `.env` pour surcharger la configuration par défaut.
# Toutes les variables sont préfixées par RF_ (voir src/restaurant_finder/config.py).

# --- Réseau ---
# IMPORTANT : Nominatim exige un User-Agent identifiable (indiquez un contact réel).
RF_USER_AGENT=RestaurantFinder/0.1 (+contact: votre-email@example.com)
RF_REQUEST_TIMEOUT_SECONDS=30
RF_HTTP_MAX_RETRIES=3

# --- Geocoding (Nominatim) ---
RF_NOMINATIM_RATE_LIMIT_SECONDS=1.0

# --- Données restaurants (Overpass) ---
RF_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
RF_OVERPASS_TIMEOUT_SECONDS=60
RF_OVERPASS_BUSY_RETRY_SECONDS=8

# --- Enrichissement Instagram ---
RF_INSTAGRAM_SEARCH_ENABLED=true
RF_INSTAGRAM_SEARCH_MAX_WORKERS=1
RF_INSTAGRAM_SEARCH_DELAY_SECONDS=1.0
RF_INSTAGRAM_MATCH_THRESHOLD=62
RF_INSTAGRAM_MAX_PROFILE_CHECKS=3
RF_INSTAGRAM_UNCONFIRMED_CITY_PENALTY=25
RF_INSTAGRAM_MAX_FOLLOWERS=1000
RF_INSTAGRAM_FILTER_BY_FOLLOWERS=true
RF_INSTAGRAM_EXCLUDE_UNKNOWN_FOLLOWERS=true
RF_INSTAGRAM_FOLLOWERS_DELAY_SECONDS=1.5
# Filtre d'activité récente (désactivé par défaut). Ex: 30 = dernier post ≤ 30 jours.
# Opportuniste : Instagram n'expose pas toujours la date dans la page publique.
# Les comptes trop anciens / sans post / date illisible restent dans l'export
# unique avec Confiance = Inactif / Date illisible (triés en bas).
# RF_INSTAGRAM_MAX_POST_AGE_DAYS=30

# --- Cache ---
RF_CACHE_ENABLED=true
RF_CACHE_DIR=.cache/restaurant_finder
RF_CACHE_TTL_SECONDS=604800

# --- Export ---
RF_DEFAULT_OUTPUT_DIR=output
